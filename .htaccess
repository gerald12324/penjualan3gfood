<IfModule mod_rewrite.c>
    Options -MultiViews -Indexes
    RewriteEngine On
    RewriteBase /web_penjualan/

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Direct requests for existing files in public/
    RewriteCond %{DOCUMENT_ROOT}/web_penjualan/public/$1 -f
    RewriteRule ^(.+)$ public/$1 [L]

    # Route all other requests to root index.php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ /web_penjualan/index.php [L,QSA]
</IfModule>
